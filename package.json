{
  "name": "spurtb2b-storefront-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "dotenv -e .env -- next build --webpack",
    "build:core": "node scripts/build-core.mjs",
    "build:template": "node scripts/build-template.mjs",
    "build:adapter": "node scripts/build-adapter.mjs",
    "build:adapter:medusa": "node scripts/build-adapter.mjs medusa",
    "build:adapter:spurt": "node scripts/build-adapter.mjs spurt",
    "deploy:adapter:spurt": "node scripts/build-adapter.mjs spurt --deploy",
    "deploy:adapter:medusa": "node scripts/build-adapter.mjs medusa --deploy",
    "build:adapters": "node scripts/build-adapter.mjs --all",
    "build:all": "node scripts/build-core.mjs && node scripts/build-adapter.mjs --all",
    "pack:dist": "node scripts/pack-standalone.mjs",
    "start": "next start -p 3004",
    "start:dist": "node dist/server.js",
    "lint": "next lint",
    "prod": "dotenv -e .env.production -- next build --webpack",
    "dev:large": "NODE_OPTIONS=--max-old-space-size=2048 npm run dev"
  },
