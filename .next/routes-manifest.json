{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/templates/[id]/[asset]",
      "regex": "^/api/templates/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPasset": "nxtPasset"
      },
      "namedRegex": "^/api/templates/(?<nxtPid>[^/]+?)/(?<nxtPasset>[^/]+?)(?:/)?$"
    },
    {
      "page": "/pages/[...slug]",
      "regex": "^/pages/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/pages/(?<nxtPslug>.+?)(?:/)?$"
    },
    {
      "page": "/products/[...slug]",
      "regex": "^/products/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
